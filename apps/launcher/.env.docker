# ── Launcher App — Environment Variables ─────────────

# ── MinIO Connection (Widget Deployment Target) ─────
MINIO_ENDPOINT=minio
MINIO_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=                             # populated by installer


# ── Widget Build Targets ───────────────────────────
API_URL_PRODUCTION=                           # populated by installer
CDN_URL_PRODUCTION=                           # populated by installer