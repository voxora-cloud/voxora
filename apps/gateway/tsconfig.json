{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "src",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@shared/*": ["shared/*"],
      "@shared/ee/*": ["shared/ee/*"],
      "@shared/ee": ["shared/ee/index.ts"],
      "@modules/*": ["modules/*"],
      "@sockets/*": ["sockets/*"]
    },
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
