
NODE_ENV=development
CLIENT_URL=http://localhost:5173
INTERAONE_MODE=self-host

# MongoDB Configuration
MONGODB_URI=mongodb://admin:dev123@localhost:27017/interaone-dev?authSource=admin

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev123

# JWT Configuration (Development - Use strong secrets in production)
JWT_SECRET=interaone-dev-jwt-secret-key-2025
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=interaone-dev-refresh-secret-key-2025
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000 # minute
RATE_LIMIT_MAX_REQUESTS=1000 # Increased limit for development, adjust for production

# Email Configuration
# Providers: mailhog (local dev) | ses (AWS SES) | disabled
EMAIL_PROVIDER=mailhog
EMAIL_FROM_NAME=InteraOne Support
EMAIL_FROM_EMAIL=noreply@interaone.app

# AWS SES Configuration (required for EMAIL_PROVIDER=ses and the Email Channel feature)
# See: https://docs.aws.amazon.com/ses/latest/dg/setting-up.html
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set to true during local dev to bypass AWS signature validation for mock tests
SKIP_SNS_VALIDATION=true
# Set to true during local dev to bypass Twilio signature validation for mock tests
SKIP_TWILIO_VALIDATION=true

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=interaone-dev
MINIO_PUBLIC_URL=http://localhost:9001

# Public API URL for webhooks (e.g. Telegram)
PUBLIC_API_URL=http://localhost:3002
