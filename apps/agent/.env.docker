# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev123

# MongoDB
MONGODB_URI=mongodb://admin:dev123@mongodb:27017/interaone?authSource=admin

# API (internal service hostname — matches 'gateway' service in docker-compose.yml)
API_URL=http://gateway:3002/api/v1

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=interaone

# Qdrant
QDRANT_URL=http://qdrant:6333

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AWS Bedrock (if LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Embeddings
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# AWS Bedrock Embeddings (if EMBEDDING_PROVIDER=bedrock)
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# RAG
RAG_TOP_K=5
CHAT_HISTORY_LIMIT=20

# Workers
WORKER_CONCURRENCY=5
INGESTION_CONCURRENCY=2

# Tool auth
AI_TOOL_SECRET=interaone_default_secret_2026
