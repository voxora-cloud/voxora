# ── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev123


# ── Database ───────────────────────────────────────
MONGODB_URI=mongodb://admin:dev123@mongodb:27017/interaone?authSource=admin


# ── Gateway API Connection ─────────────────────────
API_URL=http://gateway:3002/api/v1
AI_TOOL_SECRET=interaone_default_secret_2026


# ── MinIO (Object Storage) ─────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=interaone


# ── Qdrant (Vector Database) ───────────────────────
QDRANT_URL=http://qdrant:6333


# ── LLM Configuration ──────────────────────────────
# Options: bedrock | huggingface | ollama | openai
LLM_PROVIDER=bedrock

# AWS Bedrock LLM
AWS_REGION=us-east-1
BEDROCK_MODEL=us.amazon.nova-pro-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Hugging Face LLM
HF_TOKEN=
HF_MODEL=

# Ollama LLM
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2

# OpenAI LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# ── Embedding Configuration ────────────────────────
# Options: bedrock | huggingface | ollama | openai
EMBEDDING_PROVIDER=bedrock

# AWS Bedrock Embeddings
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Hugging Face Embeddings
HF_EMBEDDING_MODEL=
HF_EMBEDDING_DIMENSIONS=

# Ollama Embeddings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768

# OpenAI Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536


# ── RAG Settings ───────────────────────────────────
RAG_TOP_K=5
CHAT_HISTORY_LIMIT=6


# ── Workers ────────────────────────────────────────
WORKER_CONCURRENCY=5
INGESTION_CONCURRENCY=2


# ── Health Check Server ────────────────────────────
AI_HEALTH_PORT=4010
