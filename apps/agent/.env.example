# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev123

MONGODB_URI=mongodb://admin:dev123@localhost:27017/interaone?authSource=admin

# API
API_URL=http://localhost:3002/api/v1

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=interaone-dev

# Qdrant
QDRANT_URL=http://localhost:6333

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AWS Bedrock (if LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Embeddings
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# AWS Bedrock Embeddings (if EMBEDDING_PROVIDER=bedrock)
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Tool auth
AI_TOOL_SECRET=interaone_default_secret_2026