# ── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev123


# ── Database ───────────────────────────────────────
# (Not used directly by agent; routed through gateway API)
MONGODB_URI=mongodb://admin:dev123@localhost:27017/interaone-dev?authSource=admin


# ── Gateway API Connection ─────────────────────────
# (Internal service-to-service calls protected by AI_TOOL_SECRET)
API_URL=http://localhost:3002/api/v1
AI_TOOL_SECRET=interaone_default_secret_2026


# ── MinIO (Object Storage) ─────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=interaone-dev


# ── Qdrant (Vector Database) ───────────────────────
QDRANT_URL=http://localhost:6333


# ── LLM Provider ───────────────────────────────────
# Options: bedrock | huggingface | ollama | openai
LLM_PROVIDER=huggingface

# Hugging Face Configuration (e.g. DeepSeek-V4-Flash)
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V4-Flash

# AWS Bedrock LLM Configuration
# AWS_REGION=us-east-1
# BEDROCK_MODEL=us.amazon.nova-pro-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Ollama LLM Configuration
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434
# OLLAMA_MODEL=llama3.2

# OpenAI LLM Configuration
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini


# ── Embedding Provider ─────────────────────────────
# Options: bedrock | huggingface | ollama | openai
EMBEDDING_PROVIDER=huggingface

# Hugging Face Embeddings Configuration
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HF_EMBEDDING_DIMENSIONS=384

# AWS Bedrock Embeddings Configuration
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# BEDROCK_EMBEDDING_DIMENSIONS=1024

# Ollama Embeddings Configuration
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_EMBEDDING_DIMENSIONS=768

# OpenAI Embeddings Configuration
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536


# ── RAG Settings ───────────────────────────────────
RAG_TOP_K=5
CHAT_HISTORY_LIMIT=6


# ── Workers ────────────────────────────────────────
WORKER_CONCURRENCY=5
INGESTION_CONCURRENCY=2


# ── Health Check Server ────────────────────────────
AI_HEALTH_PORT=4010
