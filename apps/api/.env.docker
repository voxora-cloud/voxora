
NODE_ENV=production
PORT=3002
INTERAONE_MODE=self-host

# MongoDB (service hostname: mongodb)
MONGODB_URI=mongodb://admin:dev123@mongodb:27017/interaone?authSource=admin

# Redis (service hostname: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev123

# JWT
JWT_SECRET=interaone-dev-jwt-secret-key-2025
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=interaone-dev-refresh-secret-key-2025
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# MinIO (service hostname: minio)
MINIO_ENDPOINT=minio
MINIO_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=interaone
MINIO_PUBLIC_URL=http://localhost:9001

# CORS
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3002,http://localhost:9001

# Email
EMAIL_PROVIDER=mailhog
EMAIL_FROM_NAME=InteraOne Support
EMAIL_FROM_EMAIL=noreply@interaone.app
RESEND_API_KEY=

# Tool auth
AI_SERVICE_URL=http://ai:4010
AI_TOOL_SECRET=interaone_default_secret_2026
