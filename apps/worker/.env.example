# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev123

# Email provider: mailhog | ses | disabled
EMAIL_PROVIDER=mailhog

# MongoDB
MONGODB_URI=mongodb://admin:dev123@localhost:27017/interaone-dev?authSource=admin

# AWS SES (required when EMAIL_PROVIDER=ses)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mailhog SMTP
EMAIL_HOST=localhost
EMAIL_PORT=1025

# Email sender identity
EMAIL_FROM_NAME=InteraOne
EMAIL_FROM_EMAIL=noreply@interaone.app

# Worker tuning
WORKER_CONCURRENCY=5
