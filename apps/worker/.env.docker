# ── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                             # populated by installer


# ── Database ───────────────────────────────────────
MONGODB_URI=                                # populated by installer


# ── Email ──────────────────────────────────────────
# Providers: mailhog (local SMTP dev server) | ses (AWS SES) | disabled
EMAIL_PROVIDER=mailhog
EMAIL_FROM_NAME=InteraOne
EMAIL_FROM_EMAIL=noreply@interaone.app


# ── AWS SES Configuration ──────────────────────────
# Required when EMAIL_PROVIDER=ses
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=                           # populated by installer
AWS_SECRET_ACCESS_KEY=                       # populated by installer


# ── Worker Settings ────────────────────────────────
WORKER_CONCURRENCY=5
